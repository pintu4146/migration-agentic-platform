# Root Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Primary Provider (openai or gemini)
PRIMARY_PROVIDER=openai

# Fallback Provider (openai or gemini, or leave empty for no fallback)
FALLBACK_PROVIDER=gemini

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2000
GEMINI_TIMEOUT=60

# ============================================================================
# LangSmith Tracing
# ============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=migration-copilot-poc
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================================================
# MCP Connector Configuration (IBM Context Studio Gateway)
# ============================================================================

# MCP Gateway URL (IBM Services Essentials)
MCP_GATEWAY_URL=https://servicesessentials.ibm.com/mcp-gateway/service/gateway/servers/8ccdd203bdee4014b08e82eedb6046e2/mcp

# MCP Gateway Bearer Token
MCP_GATEWAY_TOKEN=your-mcp-gateway-token-here

# Context Studio API Key
MCP_API_KEY=your-context-studio-api-key-here

# Connection Settings
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3
MCP_RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# Redis Configuration (for caching)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600

# ============================================================================
# Qdrant Configuration (for vector storage)
# ============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=migration_context
QDRANT_API_KEY=

# ============================================================================
# Circuit Breaker Configuration
# ============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_TIMEOUT=30